# Monochrome Backend Environment Configuration
# Copy this file to .env and update with your actual values

# ==============================================================================
# Django Core Settings
# ==============================================================================

# SECURITY WARNING: Generate a new secret key for production!
# You can generate one using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your-secret-key-here-change-this-in-production

# SECURITY WARNING: Set to False in production!
DEBUG=True

# Comma-separated list of allowed hosts
# In production, set to your actual domain(s)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ==============================================================================
# Database Configuration
# ==============================================================================

# Set to False to use PostgreSQL, True to use SQLite (development only)
USE_SQLITE=True

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://monochrome_user:your_password_here@localhost:5432/monochrome_db

# Database connection pool settings (optional)
CONN_MAX_AGE=60

# ==============================================================================
# Email Configuration
# ==============================================================================

# Email backend - Use console backend for development
# Production options: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP Configuration (for production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@monochrome.com
SERVER_EMAIL=server@monochrome.com

# Email rate limiting
EMAIL_RATE_LIMIT=100/hour

# ==============================================================================
# Security Settings
# ==============================================================================

# HTTPS/SSL Settings (production only)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY

# HSTS Settings (production only)
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Session settings
SESSION_COOKIE_AGE=1209600  # 2 weeks in seconds
SESSION_EXPIRE_AT_BROWSER_CLOSE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# CSRF settings
CSRF_COOKIE_HTTPONLY=True
CSRF_COOKIE_SAMESITE=Lax
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# JWT Settings
# ==============================================================================

# JWT token lifetimes (in minutes/days)
JWT_ACCESS_TOKEN_LIFETIME=15  # 15 minutes
JWT_REFRESH_TOKEN_LIFETIME=7  # 7 days
JWT_SLIDING_TOKEN_LIFETIME=5  # 5 minutes
JWT_SLIDING_TOKEN_REFRESH_LIFETIME=1  # 1 day

# JWT Algorithm
JWT_ALGORITHM=HS256

# ==============================================================================
# Multi-Factor Authentication (MFA) Settings
# ==============================================================================

# TOTP settings
OTP_TOTP_ISSUER=Monochrome
OTP_LOGIN_URL=/auth/login/

# MFA enforcement
ENFORCE_MFA_FOR_ADMIN=True
ENFORCE_MFA_FOR_STAFF=True
MFA_RECHECK_INTERVAL=3600  # 1 hour in seconds

# Backup codes
BACKUP_CODE_COUNT=8
BACKUP_CODE_LENGTH=8

# ==============================================================================
# CORS Settings
# ==============================================================================

# Frontend URL for CORS and email links
FRONTEND_URL=http://localhost:3000

# Additional CORS allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# CORS settings
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_HEADERS=accept,accept-encoding,authorization,content-type,dnt,origin,user-agent,x-csrftoken,x-requested-with

# ==============================================================================
# Static and Media Files
# ==============================================================================

# Static files
STATIC_URL=/static/
STATIC_ROOT=staticfiles

# Media files
MEDIA_URL=/media/
MEDIA_ROOT=media

# File upload settings
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880  # 5MB
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880  # 5MB
FILE_UPLOAD_PERMISSIONS=0o644

# ==============================================================================
# Cache Configuration
# ==============================================================================

# Cache backend (use redis in production)
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=unique-snowflake

# Redis configuration (production)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300  # 5 minutes

# ==============================================================================
# Celery Configuration (if using async tasks)
# ==============================================================================

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC

# ==============================================================================
# Logging Configuration
# ==============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DJANGO_LOG_LEVEL=INFO
LOG_FILE=logs/monochrome.log

# Sentry configuration (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# ==============================================================================
# API Settings
# ==============================================================================

# API rate limiting
API_RATE_LIMIT=100/hour
API_BURST_LIMIT=10/minute

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# API versioning
API_VERSION=v1

# ==============================================================================
# Third-party Services
# ==============================================================================

# AWS S3 (for file storage in production)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_OBJECT_PARAMETERS={"CacheControl": "max-age=86400"}
AWS_DEFAULT_ACL=private

# Twilio (for SMS MFA - optional)
USE_SMS_MFA=False
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid (alternative email service - optional)
USE_SENDGRID=False
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# GeoIP2 (for location services - optional)
GEOIP_PATH=geoip
GEOIP_CITY=GeoLite2-City.mmdb
GEOIP_COUNTRY=GeoLite2-Country.mmdb

# ==============================================================================
# Development/Testing Settings
# ==============================================================================

# Test settings
TEST_RUNNER=django.test.runner.DiscoverRunner
TEST_DATABASE_NAME=test_monochrome_db

# Debug toolbar (development only)
SHOW_DEBUG_TOOLBAR=True
INTERNAL_IPS=127.0.0.1,localhost

# Faker seed (for consistent test data)
FAKER_SEED=42

# ==============================================================================
# Monitoring and Analytics
# ==============================================================================

# Google Analytics (optional)
GA_TRACKING_ID=

# Prometheus metrics (optional)
ENABLE_PROMETHEUS_METRICS=False
PROMETHEUS_METRICS_PORT=8001

# Health check
HEALTH_CHECK_TOKEN=your-health-check-token

# ==============================================================================
# Feature Flags
# ==============================================================================

# Enable/disable features
ENABLE_SOCIAL_AUTH=False
ENABLE_API_DOCS=True
ENABLE_USER_REGISTRATION=True
ENABLE_PASSWORD_RESET=True
ENABLE_EMAIL_VERIFICATION=True

# Maintenance mode
MAINTENANCE_MODE=False
MAINTENANCE_MESSAGE=The system is currently under maintenance. Please try again later.

# ==============================================================================
# Miscellaneous
# ==============================================================================

# Application version
APP_VERSION=1.0.0

# Time zone
TIME_ZONE=UTC
USE_TZ=True

# Language
LANGUAGE_CODE=en-us
USE_I18N=True
USE_L10N=True

# Default auto field
DEFAULT_AUTO_FIELD=django.db.models.BigAutoField

# Admin URL (change in production for security)
ADMIN_URL=admin/

# User upload limits
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx

# Account lockout settings
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=1800  # 30 minutes in seconds

# Password policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_NUMBERS=True
PASSWORD_REQUIRE_SPECIAL=True
PASSWORD_HISTORY_COUNT=5

# Rate limiting
LOGIN_RATE_LIMIT=5/minute
REGISTRATION_RATE_LIMIT=3/hour
PASSWORD_RESET_RATE_LIMIT=3/hour